{
  "tasks": {
    "dev": "deno run -A npm:astro dev",
    "start": "deno run -A npm:astro dev",
    "build": "deno run -A npm:astro build",
    "preview": "deno run -A npm:astro preview",
    "check": "deno run -A npm:astro check"
  },
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@^0.9.10",
    "astro": "npm:astro@5.15.8",
    "typescript": "npm:typescript@6.0.3"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
