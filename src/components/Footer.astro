---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/philippe-tremblay-36219485/' },
  { name: 'GitHub', href: 'https://github.com/philtremblay' },
  { name: 'Instagram', href: 'https://www.instagram.com/messoremclubcycliste/' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-info">
        <p class="footer-name">Philippe Tremblay</p>
        <p class="footer-tagline">Founder & Software Engineer</p>
      </div>

      <div class="footer-links">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="footer-link">
            {link.name}
          </a>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Philippe Tremblay</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: var(--space-24) 0 var(--space-12);
  }

  @media (min-width: 768px) {
    .footer {
      padding: var(--space-32) 0 var(--space-16);
    }
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .footer-tagline {
    color: var(--text-secondary);
    margin: 0;
    font-size: 0.9375rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .footer-link {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color var(--transition);
  }

  .footer-link:hover {
    color: var(--text-primary);
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .footer-bottom p {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin: 0;
  }
</style>
