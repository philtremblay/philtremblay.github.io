---
const currentYear = new Date().getFullYear();

const links = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/philippe-tremblay-36219485/' },
  { name: 'GitHub', href: 'https://github.com/philtremblay' },
  { name: 'Messorem', href: 'https://www.instagram.com/messoremclubcycliste/' },
];
---

<footer class="footer">
  <div class="shell">
    <div class="colophon">
      <div class="mark">
        <p class="name">Philippe Tremblay</p>
        <p class="eyebrow">Montréal, Québec</p>
      </div>

      <nav class="links" aria-label="Elsewhere">
        {
          links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link eyebrow"
            >
              {link.name}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="baseline">
      <span class="eyebrow">&copy; {currentYear}</span>
      <span class="eyebrow">Built with Astro</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    padding: var(--s-7) 0 var(--s-5);
    margin-top: var(--s-8);
  }

  .colophon {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding-bottom: var(--s-5);
  }

  @media (min-width: 640px) {
    .colophon {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
    margin-bottom: var(--s-1);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }

  .footer-link {
    color: var(--ink-muted);
    transition: color var(--ease);
  }

  .footer-link:hover {
    color: var(--clay);
  }

  .baseline {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-soft);
    color: var(--ink-faint);
  }

  .baseline .eyebrow {
    color: var(--ink-faint);
  }
</style>
