---
// Single-page site — no navigation. Just the wordmark and the theme toggle.
---

<header class="masthead">
  <div class="shell bar">
    <a href="/" class="wordmark">Philippe&nbsp;Tremblay</a>

    <button
      id="theme-toggle"
      class="toggle"
      type="button"
      aria-label="Toggle colour scheme"
    >
      <span class="toggle-mark" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: 56px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.005em;
    color: var(--ink);
    white-space: nowrap;
  }

  /* Toggle: a small square that fills with ink in dark mode.
     No sun/moon iconography — the state is the shape. */
  .toggle {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .toggle-mark {
    width: 11px;
    height: 11px;
    border: 1px solid var(--ink);
    background: transparent;
    transition: background var(--ease), border-color var(--ease), transform var(--ease);
  }

  .toggle:hover .toggle-mark {
    border-color: var(--clay);
    transform: rotate(45deg);
  }

  :global([data-theme='dark']) .toggle-mark {
    background: var(--ink);
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* private mode — theme just won't persist */
    }
  });
</script>
