---
const navItems = [
  { name: 'Index', href: '/#index' },
  { name: 'Projects', href: '/projects' },
  { name: 'Notes', href: '/blog' },
];
---

<header class="masthead">
  <div class="shell bar">
    <a href="/" class="wordmark">
      Philippe&nbsp;Tremblay
    </a>

    <nav class="nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href} class="nav-link eyebrow">
            {item.name}
          </a>
        ))
      }
    </nav>

    <button id="theme-toggle" class="toggle" type="button" aria-label="Toggle colour scheme">
      <span class="toggle-mark" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
    border-bottom: 1px solid var(--rule);
  }

  /* Two-row masthead on small screens so the nav stays reachable —
     no hamburger, no JS. Collapses to a single row from 640px up. */
  .bar {
    display: grid;
    grid-template-areas:
      'wordmark toggle'
      'nav      nav';
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    padding-bottom: var(--s-2);
  }

  @media (min-width: 640px) {
    .bar {
      grid-template-areas: 'wordmark nav toggle';
      grid-template-columns: auto 1fr auto;
      height: 56px;
      padding-bottom: 0;
    }
  }

  .wordmark {
    grid-area: wordmark;
    font-family: var(--font-display);
    font-size: var(--step-0);
    letter-spacing: 0.005em;
    color: var(--ink);
    white-space: nowrap;
    padding: var(--s-3) 0;
  }

  @media (min-width: 640px) {
    .wordmark {
      padding: 0;
    }
  }

  .nav {
    grid-area: nav;
    display: flex;
    gap: var(--s-5);
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule-soft);
  }

  @media (min-width: 640px) {
    .nav {
      justify-content: flex-end;
      padding-top: 0;
      border-top: 0;
      margin-right: var(--s-5);
    }
  }

  .nav-link {
    color: var(--ink-muted);
    transition: color var(--ease);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  /* Toggle: a small square that fills with ink in dark mode.
     No sun/moon iconography — the state is the shape. */
  .toggle {
    grid-area: toggle;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .toggle-mark {
    width: 11px;
    height: 11px;
    border: 1px solid var(--ink);
    background: transparent;
    transition: background var(--ease), border-color var(--ease), transform var(--ease);
  }

  .toggle:hover .toggle-mark {
    border-color: var(--clay);
    transform: rotate(45deg);
  }

  :global([data-theme='dark']) .toggle-mark {
    background: var(--ink);
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* private mode — theme just won't persist */
    }
  });
</script>
