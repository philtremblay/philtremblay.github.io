---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Hero Section - Minimal, clean, functional -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <p class="hero-label">Founder • Engineer • Cyclist</p>
        <h1 class="hero-title">Building the future of payments</h1>
        <p class="hero-description">
          Founder of Bounce, a peer-to-peer payment platform. Cloud architect and Kubernetes expert. Racing with Messorem Club Cycliste.
        </p>
        <div class="hero-actions">
          <a href="#work" class="btn btn-primary">View Work</a>
          <a href="https://www.linkedin.com/in/philippe-tremblay-36219485/" target="_blank" rel="noopener" class="btn btn-secondary">Connect</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="divider container" />

  <!-- Expertise Section -->
  <section id="work" class="section">
    <div class="container">
      <h2 class="section-title">Expertise</h2>

      <div class="expertise-list">
        <div class="expertise-item">
          <h3>Cloud Architecture</h3>
          <p>Google Cloud Professional Architect and Data Engineer. Designing resilient, scalable systems that handle millions of transactions with precision.</p>
        </div>

        <div class="expertise-item">
          <h3>Kubernetes</h3>
          <p>Certified Kubernetes Administrator (CKA). Orchestrating containerized applications with reliability and efficiency at scale.</p>
        </div>

        <div class="expertise-item">
          <h3>Cycling</h3>
          <p>Competitive cyclist with <a href="https://www.instagram.com/messoremclubcycliste/" target="_blank" rel="noopener" class="link">Messorem Club Cycliste</a>. Discipline and precision on the bike translates to excellence in engineering.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="divider container" />

  <!-- Projects Section -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Current Work</h2>

      <div class="projects-list">
        <article class="project-item">
          <div class="project-header">
            <h3>Bounce</h3>
            <span class="project-status">Active</span>
          </div>
          <p class="project-description">
            Peer-to-peer payment platform designed for seamless, secure transactions. Building the core team across backend engineering, finance, and infrastructure roles.
          </p>
          <ul class="project-tags">
            <li>Fintech</li>
            <li>P2P Payments</li>
            <li>Kubernetes</li>
            <li>Cloud</li>
          </ul>
        </article>

        <article class="project-item">
          <div class="project-header">
            <h3>Open Source</h3>
            <span class="project-status">Ongoing</span>
          </div>
          <p class="project-description">
            Contributing to cloud-native infrastructure and developer tooling. Exploring distributed systems and automation at scale.
          </p>
          <ul class="project-tags">
            <li>Cloud Native</li>
            <li>DevOps</li>
            <li>Infrastructure</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <hr class="divider container" />

  <!-- Contact Section -->
  <section class="section contact-section">
    <div class="container">
      <div class="contact-content">
        <h2>Let's Connect</h2>
        <p class="contact-description">Open to discussing cloud architecture, Kubernetes, fintech, or cycling.</p>
        <a href="https://www.linkedin.com/in/philippe-tremblay-36219485/" target="_blank" rel="noopener" class="btn btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section - Clean, functional */
  .hero {
    padding: var(--space-32) 0;
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--space-48) 0;
      min-height: 80vh;
      display: flex;
      align-items: center;
    }
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-label {
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light);
    margin-bottom: var(--space-6);
    font-weight: 500;
  }

  .hero-title {
    margin-bottom: var(--space-6);
    max-width: 16ch;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-medium);
    max-width: 600px;
    margin-bottom: var(--space-10);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Divider */
  .divider {
    max-width: var(--container-xl);
  }

  /* Section */
  .section-title {
    margin-bottom: var(--space-16);
  }

  /* Expertise List - Clean, minimal */
  .expertise-list {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 768px) {
    .expertise-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12);
    }
  }

  .expertise-item h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .expertise-item p {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Projects List */
  .projects-list {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .projects-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-16);
    }
  }

  .project-item {
    padding: var(--space-8);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }

  .project-item:hover {
    border-color: var(--text-light);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .project-header h3 {
    font-size: 1.5rem;
    margin: 0;
  }

  .project-status {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
  }

  .project-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-6);
    color: var(--text-medium);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-tags li {
    font-size: 0.8125rem;
    color: var(--text-light);
    padding: var(--space-2) var(--space-3);
    background: var(--bg);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  /* Contact Section */
  .contact-section {
    text-align: center;
  }

  .contact-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-content h2 {
    margin-bottom: var(--space-4);
  }

  .contact-description {
    font-size: 1.125rem;
    margin: 0 auto var(--space-8);
    color: var(--text-medium);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      padding: var(--space-20) 0;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .expertise-list {
      gap: var(--space-12);
    }

    .project-item {
      padding: var(--space-6);
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
