---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Hero Section - Large, bold, minimal -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <p class="hero-label">Founder • Builder • Cyclist</p>
        <h1 class="hero-title">
          Building the<br />
          future of<br />
          <span class="text-accent">payments</span>
        </h1>
        <p class="hero-description">
          Founder of Bounce, a peer-to-peer payment platform. McGill Software Engineering graduate specializing in cloud architecture and Kubernetes. Racing with Messorem Club Cycliste.
        </p>
        <div class="hero-actions">
          <a href="#work" class="btn btn-primary btn-lg">View Work</a>
          <a href="https://www.linkedin.com/in/philippe-tremblay-36219485/" target="_blank" rel="noopener" class="btn btn-secondary btn-lg">Connect</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise Section -->
  <section id="work" class="section bg-secondary">
    <div class="container">
      <div class="section-intro">
        <h2>What I Do</h2>
        <p class="section-lead">Specialized in cloud architecture, distributed systems, and building scalable applications.</p>
      </div>

      <div class="grid grid-3">
        <div class="expertise-card">
          <h3>Cloud Architecture</h3>
          <p>Google Cloud Professional Architect and Data Engineer. Designing resilient systems that scale to millions of transactions.</p>
        </div>

        <div class="expertise-card">
          <h3>Kubernetes Expert</h3>
          <p>Certified Kubernetes Administrator (CKA). Orchestrating containerized applications with precision and reliability.</p>
        </div>

        <div class="expertise-card">
          <h3>Competitive Athlete</h3>
          <p>Racing with <a href="https://www.instagram.com/messoremclubcycliste/" target="_blank" rel="noopener" class="link">Messorem Club Cycliste</a>. Discipline translates to excellence in engineering.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Projects Section -->
  <section class="section">
    <div class="container">
      <div class="section-intro">
        <h2>Current Focus</h2>
      </div>

      <div class="projects-grid">
        <div class="project-card">
          <div class="project-header">
            <h3>Bounce</h3>
            <span class="project-status">Active Development</span>
          </div>
          <p class="project-description">
            A peer-to-peer payment application designed for seamless transactions. Building the core team with 4 key positions open including Backend Engineers, Financial Director, and SRE.
          </p>
          <div class="project-stack">
            <span>Fintech</span>
            <span>P2P Payments</span>
            <span>Kubernetes</span>
            <span>Cloud Architecture</span>
          </div>
        </div>

        <div class="project-card">
          <div class="project-header">
            <h3>Open Source</h3>
            <span class="project-status">Ongoing</span>
          </div>
          <p class="project-description">
            Contributing to cloud-native projects and developer tools. Exploring new ideas in infrastructure automation and distributed systems.
          </p>
          <div class="project-stack">
            <span>Cloud Native</span>
            <span>DevOps</span>
            <span>Open Source</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section cta-section bg-secondary">
    <div class="container">
      <div class="cta-content">
        <h2>Let's Work Together</h2>
        <p>Interested in collaborating or want to discuss cloud architecture, Kubernetes, or fintech?</p>
        <a href="https://www.linkedin.com/in/philippe-tremblay-36219485/" target="_blank" rel="noopener" class="btn btn-primary btn-lg">Get in Touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-32) 0;
  }

  .hero-content {
    max-width: 1000px;
  }

  .hero-label {
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: var(--space-8);
    font-weight: 500;
  }

  .hero-title {
    margin-bottom: var(--space-8);
  }

  .hero-description {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: var(--space-12);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Section Intro */
  .section-intro {
    max-width: 800px;
    margin-bottom: var(--space-20);
  }

  .section-lead {
    font-size: 1.5rem;
    color: var(--text-secondary);
    max-width: 700px;
    margin-top: var(--space-6);
  }

  /* Expertise Cards */
  .expertise-card {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--border);
  }

  .expertise-card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }

  .expertise-card p {
    font-size: 1.0625rem;
    margin: 0;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    gap: var(--space-16);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    padding: var(--space-12);
    background: var(--bg-secondary);
    border-radius: var(--radius);
    transition: transform var(--transition);
  }

  .project-card:hover {
    transform: translateY(-4px);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-6);
    gap: var(--space-4);
  }

  .project-header h3 {
    font-size: 2rem;
    margin: 0;
  }

  .project-status {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    font-weight: 500;
    white-space: nowrap;
  }

  .project-description {
    font-size: 1.0625rem;
    margin-bottom: var(--space-8);
    line-height: 1.7;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .project-stack span {
    font-size: 0.875rem;
    color: var(--text-muted);
    padding: var(--space-2) var(--space-4);
    background: var(--bg-primary);
    border-radius: var(--radius-full);
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
  }

  .cta-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin-bottom: var(--space-6);
  }

  .cta-content p {
    font-size: 1.25rem;
    margin: 0 auto var(--space-12);
    max-width: 600px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-24) 0;
    }

    .hero-title {
      font-size: clamp(2.5rem, 12vw, 4rem);
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .expertise-card {
      padding: var(--space-8) 0;
    }

    .project-card {
      padding: var(--space-8);
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
