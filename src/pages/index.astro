---
import BaseLayout from '../layouts/BaseLayout.astro';

const capabilities = [
  {
    title: 'Cloud Architecture',
    body: 'Google Cloud Professional Architect and Professional Data Engineer. Designing systems that stay predictable as they grow — and stay legible to the people who have to run them.',
  },
  {
    title: 'Kubernetes',
    body: 'Certified Kubernetes Administrator. Orchestration, scheduling, and the unglamorous operational work that decides whether a platform holds up in production.',
  },
  {
    title: 'Distributed Systems',
    body: 'Data pipelines, event-driven services, and the failure modes that only surface at scale. Built on a McGill software engineering foundation.',
  },
];

const work = [
  {
    title: 'New venture',
    status: 'In progress',
    body: 'Heads-down on something new. More when there is something worth showing.',
    tags: ['Stealth'],
  },
  {
    title: 'Open source',
    status: 'Ongoing',
    body: 'Contributions to cloud-native infrastructure and developer tooling — mostly the parts that make operating distributed systems less painful.',
    tags: ['Cloud Native', 'Tooling', 'Infrastructure'],
    idle: true,
  },
];
---

<BaseLayout>
  <!-- ---------- Hero ---------- -->
  <section class="hero">
    <div class="shell">
      <p class="eyebrow hero-eyebrow">Montréal, Québec — Engineer &amp; Founder</p>

      <h1 class="hero-title">
        Building infrastructure that holds up when it matters.
      </h1>

      <p class="hero-lede">
        Software engineer and founder. Cloud architecture, Kubernetes, and
        distributed systems. Currently heads-down on something new.
      </p>

      <div class="hero-actions">
        <a href="#index" class="btn">The work</a>
        <a
          href="https://www.linkedin.com/in/philippe-tremblay-36219485/"
          target="_blank"
          rel="noopener"
          class="btn btn-solid">Get in touch</a
        >
      </div>
    </div>
  </section>

  <!-- ---------- Capabilities ---------- -->
  <section id="index" class="section">
    <div class="shell">
      <div class="section-head">
        <h2>What I do</h2>
        <span class="eyebrow">01 — Practice</span>
      </div>

      <div class="rows">
        {
          capabilities.map((item, i) => (
            <article class="row">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="row-title">{item.title}</h3>
              <p class="row-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Current work ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Current work</h2>
        <span class="eyebrow">02 — Building</span>
      </div>

      <div class="rows">
        {
          work.map((item, i) => (
            <article class="row work-row">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>

              <div class="work-head">
                <h3 class="row-title">{item.title}</h3>
                <span class={item.idle ? 'status status-idle' : 'status'}>
                  {item.status}
                </span>
              </div>

              <div>
                <p class="row-body">{item.body}</p>
                <ul class="tags work-tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Off the clock ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Off the clock</h2>
        <span class="eyebrow">03 — Cycling</span>
      </div>

      <p class="prose off-clock">
        Racing with
        <a
          href="https://www.instagram.com/messoremclubcycliste/"
          target="_blank"
          rel="noopener"
          class="link">Messorem Club Cycliste</a
        >. Long intervals, bad weather, and a training log that does not care how
        the week went. The habits transfer.
      </p>
    </div>
  </section>

  <!-- ---------- Contact ---------- -->
  <section class="section contact">
    <div class="shell">
      <hr class="rule" />
      <div class="contact-inner">
        <h2 class="contact-title">Let's talk.</h2>
        <p class="contact-body">
          Open to conversations about infrastructure, platform engineering, and
          early-stage building.
        </p>
        <a
          href="https://www.linkedin.com/in/philippe-tremblay-36219485/"
          target="_blank"
          rel="noopener"
          class="btn btn-solid">LinkedIn</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--s-8) 0 var(--s-7);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--s-9) 0 var(--s-8);
    }
  }

  .hero-eyebrow {
    margin-bottom: var(--s-5);
  }

  .hero-title {
    max-width: 19ch;
    margin-bottom: var(--s-5);
  }

  .hero-lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 46ch;
    margin-bottom: var(--s-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* Work rows carry a status marker beside the title */
  .work-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .work-tags {
    margin-top: var(--s-4);
  }

  .off-clock {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .contact-inner {
    padding-top: var(--s-7);
  }

  .contact-title {
    margin-bottom: var(--s-3);
  }

  .contact-body {
    max-width: 42ch;
    margin-bottom: var(--s-5);
  }

  @media (max-width: 640px) {
    .hero-actions .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
