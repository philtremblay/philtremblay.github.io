---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge">
          <span>Founder • Builder • Cyclist</span>
        </div>
        <h1 class="hero-title">
          Building the future<br />
          of <span class="text-gradient">payments</span>
        </h1>
        <p class="hero-description">
          Founder of Bounce, a peer-to-peer payment platform. McGill Software Engineering graduate with expertise in cloud architecture, Kubernetes, and scalable systems. Racing with
          <a href="https://www.instagram.com/messoremclubcycliste/" target="_blank" rel="noopener">Messorem Club Cycliste</a>
          when I'm not building.
        </p>
        <div class="hero-cta">
          <a href="#about" class="btn btn-primary btn-lg">
            Explore My Work
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/philippe-tremblay-36219485/" target="_blank" rel="noopener" class="btn btn-secondary btn-lg">Connect</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Expertise</h2>
        <p class="section-subtitle">
          From cloud infrastructure to competitive cycling
        </p>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <div class="card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3>Cloud Architecture</h3>
          <p>
            Google Cloud Professional Architect and Data Engineer. Building scalable, resilient systems that handle millions of transactions.
          </p>
        </div>

        <div class="card">
          <div class="card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <h3>Kubernetes Expert</h3>
          <p>
            Certified Kubernetes Administrator (CKA). Orchestrating containerized applications with precision and reliability.
          </p>
        </div>

        <div class="card">
          <div class="card-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3>Competitive Athlete</h3>
          <p>
            Racing with <a href="https://www.instagram.com/messoremclubcycliste/" target="_blank" rel="noopener">Messorem Club Cycliste</a>.
            Discipline on the bike translates to excellence in engineering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="projects-preview section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Current Focus</h2>
        <p class="section-subtitle">
          Building products that solve real problems
        </p>
      </div>

      <div class="grid grid-2">
        <div class="project-card featured">
          <div class="project-header">
            <div class="project-icon">💳</div>
            <div class="project-meta">
              <span class="project-status active">Active</span>
            </div>
          </div>
          <h3 class="project-title">Bounce</h3>
          <p class="project-description">
            A peer-to-peer payment application designed for seamless transactions. Currently building the team with 4 key positions open including Backend Engineers, Financial Director, and SRE.
          </p>
          <div class="project-tags">
            <span class="tag">Fintech</span>
            <span class="tag">P2P Payments</span>
            <span class="tag">Kubernetes</span>
          </div>
        </div>

        <div class="project-card">
          <div class="project-header">
            <div class="project-icon">🏗️</div>
            <div class="project-meta">
              <span class="project-status">Building</span>
            </div>
          </div>
          <h3 class="project-title">More Coming Soon</h3>
          <p class="project-description">
            Exploring new ideas in cloud infrastructure, automation, and developer tools. Check back for updates on open-source contributions and side projects.
          </p>
          <div class="project-tags">
            <span class="tag">Cloud Native</span>
            <span class="tag">DevOps</span>
          </div>
        </div>
      </div>

      <div class="cta-center">
        <a href="https://www.linkedin.com/in/philippe-tremblay-36219485/" target="_blank" rel="noopener" class="btn btn-primary">
          Connect on LinkedIn
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
  }

  .hero-content {
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--accent-light);
    color: var(--accent);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .hero-badge::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .hero-title {
    margin-bottom: var(--space-6);
    line-height: 1.1;
  }

  .hero-description {
    font-size: 1.3rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: var(--space-10);
    max-width: 650px;
    font-weight: 400;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* About Section */
  .about {
    background: var(--bg-secondary);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-20);
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-title {
    margin-bottom: var(--space-4);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: none;
    margin: 0 auto;
    line-height: 1.6;
  }

  .card {
    position: relative;
    overflow: hidden;
  }

  .card-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-light);
    color: var(--accent);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-5);
  }

  .card h3 {
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .card p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Projects Preview */
  .projects-preview {
    background: var(--bg-accent);
  }

  .project-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    transition: all var(--transition-base);
    cursor: pointer;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
    border-color: var(--accent);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-5);
  }

  .project-icon {
    font-size: 2.5rem;
  }

  .project-status {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-light);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .project-status.active {
    color: white;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-light);
  }

  .project-card.featured {
    border-width: 2px;
    border-color: var(--accent);
    background: linear-gradient(135deg, var(--bg-primary) 0%, var(--purple-50) 100%);
  }

  .project-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .project-description {
    color: var(--text-secondary);
    margin-bottom: var(--space-5);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: var(--space-1) var(--space-3);
    background: var(--bg-secondary);
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .cta-center {
    text-align: center;
    margin-top: var(--space-12);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-cta {
      flex-direction: column;
      width: 100%;
    }

    .hero-cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
