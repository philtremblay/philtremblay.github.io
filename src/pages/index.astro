---
import BaseLayout from '../layouts/BaseLayout.astro';

// Deliberately credential-neutral: what is proven, nothing about what is
// currently being built. Keep it that way.
const practice = [
  {
    title: 'Distributed Systems',
    body: 'Event-driven services, data pipelines, and the failure modes that only surface at scale.',
  },
  {
    title: 'Cloud Architecture',
    body: 'Designing systems that stay predictable as they grow, and legible to the people who run them.',
  },
  {
    title: 'Kubernetes',
    body: 'Orchestration and the operational work that decides whether a platform holds up in production.',
  },
  {
    title: 'Machine Learning',
    body: 'Applied ML in production systems — the engineering around the model, more than the model.',
  },
];

const credentials = [
  { title: 'Certified Kubernetes Administrator', note: 'CKA' },
  { title: 'Google Cloud — Professional Cloud Architect', note: 'GCP' },
  { title: 'Google Cloud — Professional Data Engineer', note: 'GCP' },
  { title: 'McGill University — Software Engineering', note: 'B.Eng.' },
];

const elsewhere = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/philippe-tremblay-36219485/' },
  { name: 'GitHub', href: 'https://github.com/philtremblay' },
];
---

<BaseLayout>
  <!-- ---------- Hero ---------- -->
  <section class="hero">
    <div class="shell">
      <p class="eyebrow hero-eyebrow">Montréal, Québec</p>

      <h1 class="hero-title">Philippe Tremblay</h1>

      <p class="hero-lede">
        Software engineer. Distributed systems, cloud infrastructure, and
        machine learning. Currently building something new.
      </p>

      <nav class="hero-links" aria-label="Elsewhere">
        {
          elsewhere.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" class="btn">
              {link.name}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ---------- Practice ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Practice</h2>
        <span class="eyebrow">01</span>
      </div>

      <div class="rows">
        {
          practice.map((item, i) => (
            <article class="row">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="row-title">{item.title}</h3>
              <p class="row-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Credentials ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Credentials</h2>
        <span class="eyebrow">02</span>
      </div>

      <div class="rows">
        {
          credentials.map((item, i) => (
            <div class="row credential">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="row-title credential-title">{item.title}</h3>
              <span class="eyebrow credential-note">{item.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Off the clock ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Off the clock</h2>
        <span class="eyebrow">03</span>
      </div>

      <p class="off-clock">
        Racing with
        <a
          href="https://www.instagram.com/messoremclubcycliste/"
          target="_blank"
          rel="noopener"
          class="link">Messorem Club Cycliste</a
        >.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--s-8) 0 var(--s-7);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--s-9) 0 var(--s-8);
    }
  }

  .hero-eyebrow {
    margin-bottom: var(--s-4);
  }

  .hero-title {
    margin-bottom: var(--s-5);
  }

  .hero-lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 42ch;
    margin-bottom: var(--s-6);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .credential {
    align-items: baseline;
  }

  .credential-title {
    font-size: var(--step-0);
    font-family: var(--font-sans);
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .credential {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    }

    .credential-note {
      text-align: right;
    }
  }

  .off-clock {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .hero-links .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
