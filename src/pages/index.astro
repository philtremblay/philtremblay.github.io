---
import BaseLayout from '../layouts/BaseLayout.astro';

// The page sells a small consulting practice. One list, in order: the first
// entry is the one Phil actually leads with, and its position is the only
// thing that says so — no second block, no label. Dravr appears as provenance
// for the expertise — never as a product, never linked. Read CLAUDE.md before
// changing copy.
const practice = [
  {
    title: 'Agent harness enablement',
    body:
      'Coding agents in a real repository, without losing control of it: instructions the agent actually follows, hooks that enforce process rather than suggest it, gates that fail closed, and a register that makes unfinished work visible instead of invisible. Delivered as a two-day team workshop, or as implementation alongside your engineers.',
  },
  {
    title: 'Private and sovereign AI deployment',
    body:
      "Model routing that keeps sensitive turns in-region, private inference on Kubernetes or OpenShift, and the cross-border transfer assessments Québec's Law 25 requires — which almost nobody has actually written.",
  },
  {
    title: 'Platform and reliability engineering',
    body:
      'Golden paths, infrastructure as code, deployment pipelines, and enough observability to know whether any of it is working.',
  },
  {
    title: 'Technical due diligence',
    body:
      'Scalability, security posture and IP hygiene, read the way a site reliability engineer reads them. For acquirers, and for founders about to become one.',
  },
  {
    title: 'Observability migration',
    body:
      'OpenTelemetry, Prometheus and Grafana — usually replacing a per-host bill that stopped making sense two renewals ago.',
  },
];

// B.Sc., not B.Eng. — the McGill degree is through Science, and this page sells
// services, so the credential has to be exact. Do not "correct" it.
const credentials = [
  { title: 'Certified Kubernetes Administrator', note: 'CKA' },
  { title: 'Google Cloud — Professional Cloud Architect', note: 'GCP' },
  { title: 'Google Cloud — Professional Data Engineer', note: 'GCP' },
  { title: 'McGill University — Software Engineering', note: 'B.Sc.' },
];

const elsewhere = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/philippe-tremblay-36219485/' },
  { name: 'GitHub', href: 'https://github.com/philtremblay' },
];
---

<BaseLayout>
  <!-- ---------- Hero ---------- -->
  <section class="hero">
    <div class="shell">
      <p class="eyebrow hero-eyebrow">Montréal, Québec</p>

      <h1 class="hero-title">Philippe Tremblay</h1>

      <p class="hero-lede">
        Distributed systems and cloud infrastructure — a decade of it, at
        Nasdaq, Metrio, Element AI and Desjardins. I take a small number of
        consulting mandates a year, mostly putting coding agents to work under
        real engineering discipline.
      </p>

      <nav class="hero-links" aria-label="Elsewhere">
        {
          elsewhere.map((link) => (
            <a href={link.href} target="_blank" rel="noopener" class="link-mono">
              {link.name}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ---------- Practice ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Practice</h2>
        <span class="eyebrow">01</span>
      </div>

      <div class="rows">
        {
          practice.map((item, i) => (
            <article class="row">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="row-title">{item.title}</h3>
              <p class="row-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Currently ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Currently</h2>
        <span class="eyebrow">02</span>
      </div>

      <p class="standfirst">
        Co-founder of Dravr, a multi-tenant platform written in Rust with a
        production MCP server across three transports. Two people build it,
        running the harness described above every day. Most of what is on this
        page comes from there.
      </p>
    </div>
  </section>

  <!-- ---------- Credentials ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Credentials</h2>
        <span class="eyebrow">03</span>
      </div>

      <div class="rows rows-tight">
        {
          credentials.map((item, i) => (
            <div class="row credential">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="row-title credential-title">{item.title}</h3>
              <span class="eyebrow credential-note">{item.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Off the clock ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Off the clock</h2>
        <span class="eyebrow">04</span>
      </div>

      <p class="standfirst">
        Racing with
        <a
          href="https://www.instagram.com/messoremclubcycliste/"
          target="_blank"
          rel="noopener"
          class="link">Messorem Club Cycliste</a
        >. Before that, seven years on the ITU triathlon circuit.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--s-5) 0;
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--s-6) 0;
    }
  }

  .hero-eyebrow {
    margin-bottom: var(--s-3);
  }

  .hero-title {
    margin-bottom: var(--s-4);
  }

  /* Spans the shell, so its edges line up with the section rule below it and
     with every row on the page. A measure this long would be wrong for running
     text; it works here because the lede is two lines — a standfirst, not a
     paragraph. Keep it short enough to stay that way. `none` is needed to beat
     the global `p { max-width: var(--measure) }`. */
  .hero-lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: none;
    margin-bottom: var(--s-4);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }

  /* A paragraph set to the shell, under a section rule — the same treatment as
     .hero-lede, so every block on the page shares one pair of edges. Named
     apart from the global .prose utility on purpose: that one caps at
     --measure, this one deliberately does not, and a shared name would make
     the override read as an accident. `none` beats the global
     `p { max-width: var(--measure) }`. Both of these run two lines or fewer at
     desktop width; a longer one would need its cap back. */
  .standfirst {
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: none;
  }

  .credential {
    align-items: baseline;
  }

  .credential-title {
    font-size: var(--step-0);
    font-family: var(--font-sans);
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .credential {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    }

    .credential-note {
      text-align: right;
    }
  }
</style>
