---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Real work only. The previous version of this page listed six invented
// projects ("Project Alpha", "Security Scanner", …) — removed rather than
// restyled.
const current = [
  {
    title: 'New venture',
    status: 'In progress',
    body: 'Building something new. Still early, still quiet — more when there is something worth showing.',
    tags: ['Stealth'],
  },
  {
    title: 'Open source',
    status: 'Ongoing',
    body: 'Contributions to cloud-native infrastructure and developer tooling, focused on making distributed systems easier to operate.',
    tags: ['Cloud Native', 'DevOps', 'Infrastructure'],
    href: 'https://github.com/philtremblay',
  },
];

const previously = [
  {
    title: 'Bounce',
    body: 'Co-founded and built a peer-to-peer payments platform — team, infrastructure, and the regulatory groundwork that comes with moving money.',
    period: 'Founder',
  },
];

const credentials = [
  { title: 'Google Cloud — Professional Cloud Architect', period: 'Certified' },
  { title: 'Google Cloud — Professional Data Engineer', period: 'Certified' },
  { title: 'Certified Kubernetes Administrator (CKA)', period: 'Certified' },
  { title: 'McGill University — Software Engineering', period: 'B.Eng.' },
];
---

<BaseLayout
  title="Projects — Philippe Tremblay"
  description="Current work, past ventures, and credentials. Cloud architecture, Kubernetes, and distributed systems."
>
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow crumb">
        <a href="/" class="crumb-link">Index</a>
        <span aria-hidden="true">/</span>
        <span>Projects</span>
      </p>
      <h1 class="page-title">Projects</h1>
      <p class="page-lede">
        What I am building now, what I built before, and the paperwork that says
        I know how.
      </p>
    </div>
  </section>

  <!-- ---------- Current ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Current</h2>
        <span class="eyebrow">01 — Active</span>
      </div>

      <div class="rows">
        {
          current.map((item, i) => (
            <article class="row">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>

              <div class="entry-head">
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener" class="row-title link">
                    {item.title}
                  </a>
                ) : (
                  <h3 class="row-title">{item.title}</h3>
                )}
                <span class="status">{item.status}</span>
              </div>

              <div>
                <p class="row-body">{item.body}</p>
                <ul class="tags entry-tags">
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Previously ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Previously</h2>
        <span class="eyebrow">02 — Shipped</span>
      </div>

      <div class="rows">
        {
          previously.map((item, i) => (
            <article class="row">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>

              <div class="entry-head">
                <h3 class="row-title">{item.title}</h3>
                <span class="eyebrow">{item.period}</span>
              </div>

              <p class="row-body">{item.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------- Credentials ---------- -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <h2>Credentials</h2>
        <span class="eyebrow">03 — On paper</span>
      </div>

      <div class="rows">
        {
          credentials.map((item, i) => (
            <div class="row credential">
              <span class="index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="row-title credential-title">{item.title}</h3>
              <span class="eyebrow credential-period">{item.period}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: var(--s-8) 0 var(--s-7);
    border-bottom: 1px solid var(--rule);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    color: var(--ink-faint);
  }

  .crumb-link {
    color: var(--ink-muted);
    transition: color var(--ease);
  }

  .crumb-link:hover {
    color: var(--clay);
  }

  .page-title {
    margin-bottom: var(--s-4);
  }

  .page-lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .entry-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .entry-tags {
    margin-top: var(--s-4);
  }

  /* Credentials read as a register, not prose */
  .credential {
    align-items: baseline;
  }

  .credential-title {
    font-size: var(--step-0);
    font-family: var(--font-sans);
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .credential {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    }

    .credential-period {
      text-align: right;
    }
  }
</style>
