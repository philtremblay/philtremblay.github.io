---
import BaseLayout from '../../layouts/BaseLayout.astro';

// No posts yet. When there are, this becomes a content collection —
// see the note in llms.txt.
const posts: { title: string; date: string; href: string; summary: string }[] = [];

const intended = [
  'Platform engineering and the cost of operating distributed systems',
  'Kubernetes in practice, past the tutorials',
  'Notes from building early-stage infrastructure',
  'Training, racing, and what endurance work teaches about shipping',
];
---

<BaseLayout
  title="Notes — Philippe Tremblay"
  description="Writing on infrastructure, platform engineering, distributed systems, and cycling."
>
  <section class="page-head">
    <div class="shell">
      <p class="eyebrow crumb">
        <a href="/" class="crumb-link">Index</a>
        <span aria-hidden="true">/</span>
        <span>Notes</span>
      </p>
      <h1 class="page-title">Notes</h1>
      <p class="page-lede">
        Occasional writing on infrastructure, platform engineering, and the
        things that break at scale.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {
        posts.length > 0 ? (
          <div class="rows">
            {posts.map((post, i) => (
              <article class="row">
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <a href={post.href} class="row-title link">
                  {post.title}
                </a>
                <p class="row-body">{post.summary}</p>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty">
            <div class="section-head">
              <h2>Nothing published yet</h2>
              <span class="eyebrow">00 — Empty</span>
            </div>

            <p class="empty-body">
              This section is deliberately empty rather than padded. When there
              is something worth reading, it will appear here.
            </p>

            <p class="eyebrow intended-label">Likely subjects</p>
            <ul class="intended">
              {intended.map((topic, i) => (
                <li class="intended-item">
                  <span class="index">{String(i + 1).padStart(2, '0')}</span>
                  <span>{topic}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: var(--s-8) 0 var(--s-7);
    border-bottom: 1px solid var(--rule);
  }

  .crumb {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
    color: var(--ink-faint);
  }

  .crumb-link {
    color: var(--ink-muted);
    transition: color var(--ease);
  }

  .crumb-link:hover {
    color: var(--clay);
  }

  .page-title {
    margin-bottom: var(--s-4);
  }

  .page-lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 44ch;
  }

  .empty-body {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 48ch;
    margin-bottom: var(--s-7);
  }

  .intended-label {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
  }

  .intended {
    list-style: none;
  }

  .intended-item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--s-3);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-soft);
  }
</style>
